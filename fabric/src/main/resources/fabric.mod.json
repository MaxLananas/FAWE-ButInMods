{
    "schemaVersion": 1,
    "id": "fawebim",
    "version": "${version}",
    "name": "FAWE-BIM",
    "description": "The WorldEdit 7.3 and FastAsyncWorldEdit command set as a standalone Fabric mod for singleplayer and servers: a buffered engine in FAWE's style (bulk chunk queue, palette-packed sections, deferred side effects, history), brushes, tools, masks, patterns, transforms and schematics. Unofficial: not affiliated with EngineHub or IntellectualSites.",
    "authors": [
        "MaxLananas"
    ],
    "contact": {
        "homepage": "https://github.com/MaxLananas/FAWE-ButInMods",
        "sources": "https://github.com/MaxLananas/FAWE-ButInMods",
        "issues": "https://github.com/MaxLananas/FAWE-ButInMods/issues"
    },
    "license": "GPL-3.0-only",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.maxlananas.fawebim.fabric.FaweMod"
        ],
        "client": [
            "com.maxlananas.fawebim.fabric.client.FaweModClient"
        ],
        "modmenu": [
            "com.maxlananas.fawebim.fabric.client.ModMenuIntegration"
        ]
    },
    "suggests": {
        "modmenu": "*"
    },
    "conflicts": {
        "worldedit": "*"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/pnJhKuU2QK"
            }
        }
    },
    "mixins": [
        "fawebim.mixins.json"
    ],
    "accessWidener": "fawebim.accesswidener",
    "depends": {
        "fabricloader": ">=0.17.3",
        "fabric-api": ">=0.136.0",
        "minecraft": "1.21.10",
        "java": ">=21"
    }
}
